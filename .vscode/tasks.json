{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build C++",
            "command": "mkdir -p \"${workspaceFolder}/build\" && clang++ -std=c++17 \"${file}\" -o \"${workspaceFolder}/build/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}